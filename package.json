{
	"name": "@jimmyphong/lingui-start",
	"version": "0.1.2",
	"description": "TanStack Start + Lingui i18n integration: SSR middleware, router hydration, locale-aware links and hooks.",
	"keywords": [
		"tanstack",
		"tanstack-start",
		"tanstack-router",
		"lingui",
		"i18n",
		"react",
		"ssr"
	],
	"author": "Jimmy Phong",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jimmyphong/lingui-start.git"
	},
	"homepage": "https://github.com/jimmyphong/lingui-start#readme",
	"bugs": {
		"url": "https://github.com/jimmyphong/lingui-start/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typings": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun run clean && NODE_ENV=production bun run build.ts",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prepublishOnly": "bun run typecheck && bun run build",
		"npm:publish": "npm publish --access public",
		"npm:dry-run": "npm publish --access public --dry-run"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"@lingui/core": "^6.5.0",
		"@lingui/react": "^6.5.0",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.32"
	}
}
