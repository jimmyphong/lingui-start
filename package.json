{
	"name": "@sourceking/tanstack-lingui",
	"version": "0.1.2",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typings": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun run clean && NODE_ENV=production bun run build.ts",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"npm:publish": "npm publish --access public",
		"npm:dry-run": "npm publish --access public --dry-run"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4"
	},
	"peerDependencies": {
		"typescript": "^5.9.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"@lingui/core": "^6.5.0",
		"@lingui/react": "^6.5.0",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.32"
	}
}
