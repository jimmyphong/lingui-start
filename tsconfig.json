{
	"compilerOptions": {
		"jsx": "react-jsx",
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun-types"],
		"allowJs": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"rootDir": "./src",
		"outDir": "dist",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"paths": {
			"react": ["./node_modules/@types/react"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
